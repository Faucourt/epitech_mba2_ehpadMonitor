# Configuration exemple EHPAD Monitor
# Copier ce fichier en .env puis adapter les secrets avant un usage reel.

# Redis
REDIS_PASSWORD=change-me-redis-long-random

# InfluxDB
INFLUX_INIT_PASSWORD=change-me-influx-password
INFLUX_TOKEN=change-me-influx-token

# Simulation
NUM_RESIDENTS=25

# Sessions et comptes demo
SESSION_SECRET=change-me-session-hmac-32-bytes-minimum
STAFF_DEMO_PASSWORD=change-me-demo-staff-password
FAMILLE_ADMIN_TOKEN=change-me-admin-token

# Dashboard / securite HTTP
ALLOWED_ORIGINS=http://localhost:3002,http://127.0.0.1:3002
HTTPS_REQUIRED=false
RETENTION_ACCESS_LOG_DAYS=365
RETENTION_AUDIT_DAYS=365

# LLM local optionnel
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=meditron:7b
LLM_DAILY_AUTO_ENABLED=false
LLM_DAILY_TTL_DAYS=45

# Web Push mobile optionnel
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_EMAIL=admin@ehpad.local
